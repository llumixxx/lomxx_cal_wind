from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
import json
import time
from datetime import datetime
import os
import re

USERNAME = "thd9493"
PASSWORD = "song4182"
BASE_URL = "https://wind01.net/tools/pet.php"
SAVE_FILE = "pet_ranking_data.json"
INTERVAL = 86400  # 24시간

def parse_ranking_from_html(html_content):
    """HTML에서 랭킹 정보 추출"""
    general = []
    rebirth = []
    
    tables = re.findall(r'<table class="rank-table">(.*?)</table>', html_content, re.DOTALL)
    
    # 첫 번째 테이블 (일반 랭킹)
    if len(tables) > 0:
        tbody = re.search(r'<tbody>(.*?)</tbody>', tables[0], re.DOTALL)
        if tbody:
            rows = re.findall(r'<tr[^>]*>(.*?)</tr>', tbody.group(1), re.DOTALL)
            
            for i, row in enumerate(rows[:5]):
                cells = re.findall(r'<td[^>]*>(.*?)</td>', row, re.DOTALL)
                cells_text = [re.sub(r'<[^>]+>', '', cell).strip() for cell in cells]
                
                if len(cells_text) >= 8:
                    general.append({
                        'rank': i + 1,
                        'nickname': cells_text[1],
                        'level': cells_text[2],
                        'exp': cells_text[3],
                        'attack': cells_text[4],
                        'defense': cells_text[5],
                        'speed': cells_text[6],
                        'score': cells_text[7]
                    })
    
    # 두 번째 테이블 (환생 랭킹)
    if len(tables) > 1:
        tbody = re.search(r'<tbody>(.*?)</tbody>', tables[1], re.DOTALL)
        if tbody:
            rows = re.findall(r'<tr[^>]*>(.*?)</tr>', tbody.group(1), re.DOTALL)
            
            for i, row in enumerate(rows[:5]):
                cells = re.findall(r'<td[^>]*>(.*?)</td>', row, re.DOTALL)
                cells_text = [re.sub(r'<[^>]+>', '', cell).strip() for cell in cells]
                
                if len(cells_text) >= 8:
                    rebirth.append({
                        'rank': i + 1,
                        'nickname': cells_text[1],
                        'level': cells_text[2],
                        'exp': cells_text[3],
                        'attack': cells_text[4],
                        'defense': cells_text[5],
                        'speed': cells_text[6],
                        'score': cells_text[7]
                    })
    
    return general, rebirth

print("=" * 70)
print("페트 랭킹 수집 (308마리, 매일 24시간마다)")
print("=" * 70)

options = webdriver.ChromeOptions()
options.add_argument('--start-maximized')

try:
    driver = webdriver.Chrome(options=options)
    
    print(f"\n페이지 접속...")
    driver.get(BASE_URL)
    time.sleep(3)
    
    # 로그인
    print(f"로그인...")
    try:
        id_input = WebDriverWait(driver, 10).until(EC.presence_of_element_located((By.NAME, "id")))
        id_input.send_keys(USERNAME)
        driver.find_element(By.NAME, "password").send_keys(PASSWORD)
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
        time.sleep(3)
        print("✓ 로그인 성공\n")
    except:
        print("이미 로그인됨\n")
    
    from datetime import date, time as datetime_time, timedelta
    
    collection_count = 0
    
    while True:
        collection_count += 1
        
        # 다음 00시까지 대기 (첫 실행 제외)
        if collection_count > 1:
            now = datetime.now()
            tomorrow_midnight = datetime.combine(date.today() + timedelta(days=1), datetime_time(0, 0, 0))
            wait_seconds = (tomorrow_midnight - now).total_seconds()
            
            print(f"\n⏰ 다음 업데이트: {tomorrow_midnight.strftime('%Y-%m-%d %H:%M:%S')}")
            print(f"대기 중... ({int(wait_seconds // 3600)}시간 {int((wait_seconds % 3600) // 60)}분)\n")
            time.sleep(wait_seconds)
        
        print(f"\n{'='*70}")
        print(f"수집 #{collection_count} - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        print(f"{'='*70}\n")
        
        # 펫 목록 찾기
        time.sleep(1)
        pet_buttons = driver.find_elements(By.CLASS_NAME, "petItem")
        pet_names = [btn.text.strip() for btn in pet_buttons if btn.text.strip()]
        
        print(f"발견된 펫: {len(pet_names)}마리\n")
        
        all_pets_data = []
        
        # 모든 펫 처리
        for idx, pet_name in enumerate(pet_names, 1):
            print(f"[{idx:3d}/{len(pet_names)}] {pet_name:20s}", end=" ", flush=True)
            
            # 펫 버튼 클릭
            pet_buttons = driver.find_elements(By.CLASS_NAME, "petItem")
            for btn in pet_buttons:
                if btn.text.strip() == pet_name:
                    driver.execute_script("arguments[0].click();", btn)
                    break
            
            time.sleep(0.8)
            
            # HTML 추출 및 파싱
            page_source = driver.page_source
            general_ranking, rebirth_ranking = parse_ranking_from_html(page_source)
            
            pet_data = {
                'name': pet_name,
                'general_ranking': general_ranking,
                'rebirth_ranking': rebirth_ranking
            }
            
            all_pets_data.append(pet_data)
            
            print(f"✓ 일반{len(general_ranking)}명, 환생{len(rebirth_ranking)}명")
        
        # 데이터 저장
        collection_data = {
            'timestamp': datetime.now().isoformat(),
            'date': datetime.now().strftime('%Y-%m-%d'),
            'time': datetime.now().strftime('%H:%M:%S'),
            'total_pets': len(all_pets_data),
            'pets': all_pets_data
        }
        
        if os.path.exists(SAVE_FILE):
            with open(SAVE_FILE, 'r', encoding='utf-8') as f:
                all_data = json.load(f)
        else:
            all_data = []
        
        all_data.append(collection_data)
        
        with open(SAVE_FILE, 'w', encoding='utf-8') as f:
            json.dump(all_data, f, ensure_ascii=False, indent=2)
        
        print(f"\n✓ 완료! 저장된 기록: {len(all_data)}개")

except KeyboardInterrupt:
    print("\n\n프로그램 종료")
finally:
    driver.quit()
